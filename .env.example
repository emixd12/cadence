# Runtime-owned modes. Local development defaults to development; Vercel sets VERCEL_ENV.
NODE_ENV=development
VERCEL_ENV=

# Supabase runtime. Blank URL/key values make authenticated product routes unavailable.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred public API key for new Supabase projects. Legacy anon keys are still supported below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Desktop bundles use only these public values. Keep service/provider secrets out of VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional production verification canary. Keep unset outside the bounded Ticket 100 procedure.
CADENCE_ACCOUNT_DELETION_FAILURE_CANARY_USER_ID=
# Bounded desktop release acceptance inputs. Do not persist real canary values.
CADENCE_DESKTOP_RELEASE_EXPECTED_SCHEMA_VERSION=
CADENCE_DESKTOP_RELEASE_SECRET_CANARIES=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Supabase CLI / hosted project reference
# Prefer `npm run supabase -- login` and `npm run supabase -- link` for CLI auth.
SUPABASE_PROJECT_REF=
# Ticket 102 Actions-only Management API token. Never expose or log this value.
SUPABASE_ACCESS_TOKEN=

# Ticket 102 Public Trust workflow. GitHub provides the GITHUB_* values.
# Keep provider credentials in protected Actions environments, not local files.
GITHUB_REPOSITORY=
GITHUB_RUN_ID=
GITHUB_SERVER_URL=
GITHUB_SHA=
GITHUB_TOKEN=
PUBLIC_TRUST_INPUT=
CADENCE_TRUST_MARKETING_DEPLOYMENT_ID=
VERCEL_DEPLOYMENT_ID=
VERCEL_GIT_COMMIT_SHA=
RUN_RLS=
TRUST_SOURCE_COMMIT=
TRUST_APPLICATION_DEPLOYMENT_ID=
TRUST_APPLICATION_DEPLOYMENT_URL=
TRUST_MARKETING_DEPLOYMENT_ID=
TRUST_MARKETING_DEPLOYMENT_URL=
TRUST_PAGES_ORIGIN=
TRUST_TARGET=
APPLICATION_PRODUCTION_ORIGIN=
MARKETING_PRODUCTION_ORIGIN=
VERCEL_APPLICATION_PROJECT_ID=
VERCEL_MARKETING_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TOKEN=

# Auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local QA only. Keep disabled unless you are running a clean-session onboarding test.
CADENCE_ENABLE_TEST_LOGIN=
# Required only when the local app points at a hosted Supabase project.
CADENCE_ALLOW_HOSTED_TEST_LOGIN=
# Optional cleanup window for temporary test users, defaults to 24 hours.
CADENCE_TEST_LOGIN_MAX_AGE_HOURS=

# Public surface routing. Source falls back to production URLs when these are absent.
# Set every Preview value explicitly or Preview links can send testers to Production.
NEXT_PUBLIC_MARKETING_SITE_URL=https://cadence-marketing-two.vercel.app
MARKETING_SITE_URL=https://cadence-marketing-two.vercel.app
# Astro's built-in site value; the marketing source otherwise uses its production fallback.
SITE=https://cadence-marketing-two.vercel.app
PUBLIC_CADENCE_APP_URL=https://cadence-blush-three.vercel.app

# Sequenzy runtime and CLI
# Blank API key or template slug disables email delivery while browser push remains available.
# SEQUENZY_API_KEY is server-only. Never expose it with NEXT_PUBLIC_.
SEQUENZY_API_KEY=
SEQUENZY_REMINDER_TEMPLATE_SLUG=
SEQUENZY_API_URL=https://api.sequenzy.com
SEQUENZY_APP_URL=https://sequenzy.com

# Agent-owned test inboxes for email QA. Not a production sending provider credential.
AGENTMAIL_API_KEY=

# Web Push. Blank keys make browser reminder registration and delivery unavailable.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Internal cron/process protection. Blank secrets make process routes unavailable.
REMINDER_PROCESS_SECRET=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET; use the same value as REMINDER_PROCESS_SECRET.
CRON_SECRET=

# Launch incident circuit breakers. Server-only. Empty means normal behavior.
# Set one scoped flag to 1 only through the Ticket 067 incident runbook.
CADENCE_DISABLE_EMAIL_SENDS=
CADENCE_DISABLE_BROWSER_PUSH_SENDS=
CADENCE_DISABLE_REMINDER_BATCHES=
CADENCE_DISABLE_OCCURRENCE_SYNC_BATCHES=
CADENCE_DISABLE_EXPORT_DOWNLOADS=
# Allowed values: abuse, application_regression, cost_surge, operator_drill, provider_incident.
CADENCE_LAUNCH_BREAKER_REASON_CODE=

# Privacy-safe server timing. Empty is equivalent to 0 and emits no timing logs.
CADENCE_PERF_LOG=0

# Design-system checker. Empty uses /Users/emi/.codex/skills/design-system-bench.
DESIGN_SYSTEM_BENCH_SKILL_DIR=

# Local performance harness defaults. An empty cookie runs unauthenticated requests.
CADENCE_PERF_BASE_URL=http://localhost:3000
# Empty uses /timeline,/behaviors,/export,/settings.
CADENCE_PERF_ROUTES=
CADENCE_PERF_RUNS=3
CADENCE_PERF_WARMUPS=1
CADENCE_PERF_COOKIE_HEADER=

# Ticket 098 local artifact audit. Commands inject JSON arrays of synthetic values.
# Keep both empty outside the bounded public-repository release proof.
CADENCE_TICKET_098_SERVER_CANARIES=
CADENCE_TICKET_098_PUBLIC_CANARIES=

# Supervised local load-test lifecycle. Commands normally inject run-specific values.
# A missing run id or required confirmation makes destructive setup/cleanup refuse to run.
CADENCE_LOAD_RUN_ID=
CADENCE_LOAD_CONFIRM_RUN_ID=
CADENCE_LOAD_BASE_URL=http://127.0.0.1:3100
CADENCE_LOAD_ACCOUNT_COUNT=1
CADENCE_LOAD_HEAVY_COUNT=0
# Empty lets the selected supervised suite choose its declared cohort.
CADENCE_LOAD_COHORT=
# Empty uses the command's local private run directory and current local-date anchor.
CADENCE_LOAD_RUN_DIRECTORY=
CADENCE_LOAD_ANCHOR_LOCAL_DATE=
CADENCE_LOAD_AUTH_CONCURRENCY=4
# Empty applies the harness pacing policy; 0 removes the optional minimum interval.
CADENCE_LOAD_AUTH_MIN_INTERVAL_MS=
# Empty keeps mutation fixtures disabled unless the supervised command enables them.
CADENCE_LOAD_MUTATION_FIXTURES=

# Loopback fake Sequenzy. Blank run id/key values make the supervised harness reject startup.
CADENCE_LOAD_FAKE_SEQUENZY_API_KEY=
CADENCE_LOAD_FAKE_SEQUENZY_TEMPLATE_SLUG=cadence-load-habit-reminder
CADENCE_LOAD_FAKE_SEQUENZY_HOST=127.0.0.1
# Port 0 selects an available loopback port.
CADENCE_LOAD_FAKE_SEQUENZY_PORT=0
CADENCE_LOAD_FAKE_SEQUENZY_MAX_REQUESTS=5000
# Empty disables the optional private request snapshot.
CADENCE_LOAD_FAKE_SEQUENZY_SNAPSHOT_FILE=
## Desktop release only. Supply real credentials through the release shell.
## Keep these blank in source control. The app does not read release secrets.
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=
APPLE_ID=
APPLE_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_TEAM_ID=
## Absolute path to the matching Developer ID provisioning profile.
CADENCE_APPLE_PROVISIONING_PROFILE=
CADENCE_UPDATER_ENDPOINT=
CADENCE_UPDATER_PUBLIC_KEY=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
## Must remain unset for the release helper; it uses its reviewed overlay.
TAURI_CONFIG=

# Optional read-only Calendar connector; configure only after provider approval.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_CALLBACK_URL=
# Keep the previous exact HTTPS callback registered during a domain migration.
GOOGLE_CALENDAR_LEGACY_CALLBACK_URL=
GOOGLE_CALENDAR_ENCRYPTION_KEY=
GOOGLE_CALENDAR_KEY_ID=
GOOGLE_CALENDAR_DECRYPTION_KEYS=
VITE_CALENDAR_BROKER_ORIGIN=

# Service connection bootstrap: cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_NAME=
# CLOUDFLARE_ZONE_ID=

# Optional in-app Daily Brief. Server-only; never prefix with NEXT_PUBLIC_ or VITE_.
OPENAI_API_KEY=
# Development-only workbench provider calls per process hour, 1–100. Production admission is separate.
CADENCE_BRIEFING_BENCH_CALL_LIMIT=100

# Travel remains disabled until Ticket 165 provider, billing and restricted-key review.
CADENCE_TRAVEL_PROVIDER_CLEARANCE=disabled
# Local development retains the IP-restricted key and Geocoding v3 path.
CADENCE_TRAVEL_GOOGLE_AUTH_MODE=api_key
GOOGLE_MAPS_SERVER_API_KEY=
# Production uses the request-scoped Vercel OIDC token. Never store that token here.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_WORKLOAD_IDENTITY_PROVIDER=
GOOGLE_CLOUD_TRAVEL_SERVICE_ACCOUNT_EMAIL=
CADENCE_TRAVEL_VERCEL_OIDC_ISSUER=
CADENCE_TRAVEL_VERCEL_OIDC_AUDIENCE=
CADENCE_TRAVEL_VERCEL_OIDC_SUBJECT=
CADENCE_TRAVEL_VERCEL_OIDC_OWNER_ID=
CADENCE_TRAVEL_VERCEL_OIDC_PROJECT_ID=
CADENCE_TRAVEL_VERCEL_OIDC_ENVIRONMENT=
