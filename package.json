{
  "name": "cadence-tracker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "popmelt wrap -- next dev --port 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "desktop:dev": "npm --workspace apps/desktop run dev",
    "desktop:dev:web": "npm --workspace apps/desktop run dev:web",
    "desktop:build": "npm --workspace apps/desktop run build",
    "desktop:typecheck": "npm --workspace apps/desktop run typecheck",
    "desktop:native:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:native:build": "npm --workspace apps/desktop run tauri -- build --debug --bundles app --config src-tauri/tauri.local.conf.json",
    "desktop:parity:check": "node scripts/check-interactions.mjs --desktop-release",
    "marketing:dev": "npm --workspace apps/marketing run dev",
    "marketing:build": "npm --workspace apps/marketing run build",
    "marketing:check": "npm --workspace apps/marketing run check",
    "marketing:preview": "npm --workspace apps/marketing run preview",
    "design-system:check": "node scripts/check-design-system.mjs",
    "agents:check": "node scripts/check-agents.mjs",
    "interactions:check": "node scripts/check-interactions.mjs",
    "resolvers:check": "node scripts/check-resolvers.mjs",
    "core:check": "node scripts/check-core-portability.mjs",
    "behaviorlog:conformance": "vitest run tests/behaviorlog-conformance.test.ts",
    "public-source:check": "node scripts/check-public-source-boundary.mjs source",
    "public-artifacts:check": "node scripts/check-public-source-boundary.mjs artifacts",
    "public-database:audit:local": "node scripts/audit-public-database.mjs",
    "public-trust:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-public-trust-evidence.mjs",
    "public-trust:fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/collect-public-trust-evidence.mjs --fixture tests/fixtures/public-trust-collector/input.json --output /tmp/cadence-public-trust-fixture.json --details-output /tmp/cadence-public-trust-details-fixture.json",
    "public-trust:collect": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/collect-public-trust-evidence.mjs",
    "public-trust:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-public-trust-snapshot.mjs",
    "public-trust:history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/download-public-trust-history.mjs",
    "public-trust:publish": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/publish-public-trust-evidence.mjs",
    "perf:routes": "node scripts/performance-route-harness.mjs",
    "load:install": "python3 -m venv load-tests/.venv && load-tests/.venv/bin/python -m pip install --requirement load-tests/requirements.txt",
    "load:manifest:check": "node scripts/check-load-test-interactions.mjs",
    "load:python:test": "PYTHONPATH=load-tests load-tests/.venv/bin/python -m unittest discover -s load-tests/tests",
    "load:web": "node scripts/load-test-protocol-smoke.mjs --web",
    "load:protocol:smoke": "node scripts/load-test-protocol-smoke.mjs --headless",
    "load:provision": "node scripts/load-test-provision.mjs",
    "load:seed": "node scripts/load-test-seed.mjs",
    "load:integrity": "node scripts/load-test-integrity.mjs",
    "load:cleanup": "node scripts/load-test-cleanup.mjs",
    "load:read:smoke": "node scripts/load-test-read-suite.mjs --suite smoke",
    "load:read:baseline": "node scripts/load-test-read-suite.mjs --suite baseline",
    "load:read:ramp": "node scripts/load-test-read-suite.mjs --suite ramp",
    "load:read:full": "node scripts/load-test-read-suite.mjs --suite full",
    "load:mutation:smoke": "node scripts/load-test-mutation-suite.mjs --suite smoke",
    "load:mutation:baseline": "node scripts/load-test-mutation-suite.mjs --suite baseline",
    "load:mutation:ramp": "node scripts/load-test-mutation-suite.mjs --suite ramp",
    "load:mutation:spike": "node scripts/load-test-mutation-suite.mjs --suite spike",
    "load:mutation:soak": "node scripts/load-test-mutation-suite.mjs --suite soak",
    "load:mutation:breakpoint": "node scripts/load-test-mutation-suite.mjs --suite breakpoint",
    "load:mutation:timezone": "node scripts/load-test-mutation-suite.mjs --suite timezone",
    "load:mutation:contention": "node scripts/load-test-mutation-suite.mjs --suite contention",
    "load:mutation:operator": "node scripts/load-test-mutation-suite.mjs --suite operator",
    "load:mutation:full": "node scripts/load-test-mutation-suite.mjs --suite full",
    "load:mutation:evidence:check": "node scripts/check-load-test-mutation-evidence.mjs",
    "load:hosted:preflight": "node scripts/load-test-hosted-preflight.mjs",
    "launch:cost:preflight": "node scripts/launch-cost-preflight.mjs",
    "launch:surge:drill": "node scripts/launch-surge-drill.mjs",
    "smoke:rls": "node scripts/supabase-rls-smoke.mjs",
    "smoke:rls:local": "node scripts/supabase-rls-smoke.mjs --local",
    "smoke:account-sync": "node scripts/account-sync-rpc-smoke.mjs",
    "smoke:account-sync:local": "node scripts/account-sync-rpc-smoke.mjs --local",
    "desktop:release:acceptance": "node scripts/desktop-release-acceptance.mjs",
    "smoke:launch-rate-limit:local": "psql postgresql://postgres:postgres@127.0.0.1:55322/postgres -v ON_ERROR_STOP=1 -f tests/sql/ticket-067-launch-rate-limit-smoke.sql",
    "smoke:push-cap:local": "node scripts/push-subscription-cap-smoke.mjs",
    "smoke:schedule-integrity:local": "psql postgresql://postgres:postgres@127.0.0.1:55322/postgres -v ON_ERROR_STOP=1 -f tests/sql/ticket-060-schedule-integrity-smoke.sql",
    "test-login:cleanup": "node scripts/supabase-test-login-cleanup.mjs",
    "agentmail": "node scripts/agentmail-cli.mjs",
    "agentmail:version": "node scripts/agentmail-cli.mjs --version",
    "supabase": "supabase",
    "sequenzy": "npm exec --yes --package=@sequenzy/cli@0.0.34 -- sequenzy",
    "desktop:contract:test": "cargo build --offline --manifest-path apps/desktop/src-tauri/Cargo.toml --features contract-harness --bin local-store-contract && CADENCE_SQLITE_CONTRACT=1 vitest run tests/desktop-store-contract.test.ts tests/desktop-portability-contract.test.ts",
    "services:preflight": "node scripts/service-preflight.mjs",
    "services:preflight:network": "node scripts/service-preflight.mjs --network",
    "cloudflare": "node scripts/cloudflare-api.mjs",
    "cloudflare:verify": "node scripts/cloudflare-api.mjs verify",
    "search-console": "node scripts/search-console.mjs"
  },
  "dependencies": {
    "@cadence/core": "*",
    "@cadence/ui": "*",
    "@js-temporal/polyfill": "^0.5.1",
    "@popmelt.com/core": "^0.16.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "lucide-react": "^1.17.0",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "agentmail-cli": "^0.7.14",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "supabase": "^2.105.0",
    "tailwindcss": "^4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "svgo": "^4.0.2"
  },
  "allowScripts": {
    "agentmail-cli@0.7.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": "24.x"
  }
}
