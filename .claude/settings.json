{
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-cloud-session.sh\"",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/git-freshness.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking Git freshness"
          }
        ]
      }
    ]
  }
}
