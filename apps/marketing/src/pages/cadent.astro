  <script is:inline>
    // Play the looping videos only when the visitor allows motion; otherwise the posters stay as stills.
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const videos = document.querySelectorAll("video");
    const syncMotion = () => videos.forEach((video) => (reducedMotion.matches ? video.pause() : video.play().catch(() => {})));
    syncMotion();
    reducedMotion.addEventListener("change", syncMotion);
  </script>
