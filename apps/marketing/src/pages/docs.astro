---
import { getRouteById, marketingRoutes } from "../data/routes";
import { primaryCtas, siteConfig } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const route = getRouteById("docs");
const agentRuleSnippet = JSON.stringify(
  {
    standard: siteConfig.standardUrl,
    example_bundle: siteConfig.exampleBundlePath,
    status_authority: "data/status_events.jsonl",
    current_status_role: "snapshot",
  },
  null,
  2,
);
const machineFiles = [
  [siteConfig.trustUrl, "Canonical human Trust page with durable commitments and current verification results."],
  [siteConfig.trustEvidenceUrl, "Normalized current Trust evidence as JSON."],
  [`${siteConfig.cadenceAppUrl}/privacy`, "Canonical HTML privacy notice on the application origin."],
  [`${siteConfig.cadenceAppUrl}/terms`, "Canonical HTML terms on the application origin."],
  ["/llms.txt", "Curated index for working agents and developer tools."],
  ["/llms-full.txt", "Small full-site text bundle with page boundaries."],
  ["/data/route-manifest.json", "Public route manifest used by generators."],
  ["/sitemap.xml", "Canonical HTML route sitemap."],
  ["/robots.txt", "Max-visibility crawl policy and sitemap pointer."],
  ["/faq.md", "Markdown mirror for the frequently asked questions route."],
  ["/examples.md", "Markdown mirror for the examples route."],
  ["/docs.md", "Markdown mirror for this docs route."],
  ["/about.md", "Markdown mirror for the launch about route."],
  ["/index.md", "Markdown mirror for the homepage."],
] as const;
---

<BaseLayout route={route}>
  <section class="page-section hero" aria-labelledby="docs-title">
    <div class="page-section__inner">
      <div class="stack">
        <h1 id="docs-title">Docs for Cadence and portable behavior records.</h1>
        <p>
          Start here when a developer or agent needs to understand Cadence, inspect a
          BehaviorLog bundle, cite a canonical page, or parse the example export
          without opening the app.
        </p>
        <div class="cta-row">
          <a class="button button--primary" href="/llms.txt">Open llms.txt</a>
          <a class="button" href="/data/route-manifest.json">Open route manifest</a>
          <a class="button" href={primaryCtas.readStandard.href}>
            {primaryCtas.readStandard.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="quick-start-title">
    <div class="page-section__inner">
      <div class="split-grid">
        <div class="ledger-row">
          <h2 id="quick-start-title">Quick start</h2>
          <ul class="text-list">
            <li>Open <a class="inline-link" href={siteConfig.trustUrl}>Trust</a> for current bounded verification results and durable product commitments.</li>
            <li>Open <a class="inline-link" href="/">Cadence</a> for product scope and user-facing behavior.</li>
            <li>Open <a class="inline-link" href={siteConfig.standardUrl}>BehaviorLog</a> for bundle structure and status semantics.</li>
            <li>Download the <a class="inline-link" href={primaryCtas.downloadExample.href}>example bundle</a> for parser tests.</li>
          </ul>
        </div>
        <div class="ledger-row">
          <h2>Reader contract</h2>
          <p>
            Cadence stores manual behavior decisions. BehaviorLog preserves those
            decisions in files. A reader should never convert unresolved into failure
            or treat a current-status snapshot as the full event history.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="machine-files-title">
    <div class="page-section__inner">
      <div class="stack">
        <h2 id="machine-files-title">Machine files</h2>
        <div class="table-scroll">
          <table class="file-table">
            <thead>
              <tr>
                <th scope="col">URL</th>
                <th scope="col">Use</th>
              </tr>
            </thead>
            <tbody>
              {
                machineFiles.map(([href, purpose]) => (
                  <tr>
                    <td>
                      <a class="inline-link" href={href}>{href}</a>
                    </td>
                    <td>{purpose}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="route-manifest-title">
    <div class="page-section__inner">
      <div class="stack">
        <h2 id="route-manifest-title">Public route manifest</h2>
        <div class="table-scroll">
          <table class="route-table">
            <thead>
              <tr>
                <th scope="col">Route</th>
                <th scope="col">Type</th>
                <th scope="col">Markdown</th>
                <th scope="col">Description</th>
              </tr>
            </thead>
            <tbody>
              {
                marketingRoutes.map((entry) => (
                  <tr>
                    <td>
                      <a class="inline-link" href={entry.path}>{entry.path}</a>
                    </td>
                    <td>{entry.type}</td>
                    <td>
                      <a class="inline-link" href={entry.markdownPath}>{entry.markdownPath}</a>
                    </td>
                    <td>{entry.description}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="analysis-boundary-title">
    <div class="page-section__inner">
      <div class="stack">
        <h2 id="analysis-boundary-title">Analysis boundary</h2>
        <p>
          Adherence includes only decided Occurrences. Keep Unresolved separate. Do not infer
          causes, clinical meaning, or motivation from a Record. You choose whether to share exports with an external AI service. Separately, where enabled, optional Daily Brief sends disclosed context to OpenAI. Each connected source needs its own model-data choice.
        </p>
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="agent-rules-title">
    <div class="page-section__inner section-grid">
      <div class="stack">
        <h2 id="agent-rules-title">Rules for agents</h2>
        <ul class="text-list">
          <li>Prefer Markdown mirrors when context budget matters.</li>
          <li>Cite canonical HTML URLs when answering humans.</li>
          <li>
            Use <code>data/status_events.jsonl</code> as the BehaviorLog history
            authority.
          </li>
          <li>Do not infer a failed behavior from unresolved status.</li>
          <li>Do not treat the example bundle as real user data.</li>
        </ul>
      </div>
      <div class="code-panel">
        <pre><code>{agentRuleSnippet}</code></pre>
      </div>
    </div>
  </section>
</BaseLayout>
