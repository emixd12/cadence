---
import "@fontsource-variable/ibm-plex-sans/index.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import BrandMarks from "../components/BrandMarks.astro";
import RouteJsonLd from "../components/RouteJsonLd.astro";
import { getCanonicalUrl, type MarketingRoute } from "../data/routes";
import { primaryCtas, siteConfig } from "../data/site";
import "../styles/global.css";

type Props = {
  route: MarketingRoute;
};

const { route } = Astro.props;
const canonicalUrl = getCanonicalUrl(route.path);
const markdownUrl = getCanonicalUrl(route.markdownPath);
const pageTitle = route.path === "/" ? "Cadence · Decide your days, own every record" : `${route.title} | Cadence`;
const ogImageUrl = getCanonicalUrl("/brand/cadence-logo-512.png");
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={route.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/brand/cadence-favicon-64.png" />
    <link rel="alternate" type="text/markdown" href={markdownUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={route.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={route.type === "documentation" ? "article" : "website"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={route.description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <RouteJsonLd route={route} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="brand-lockup" href="/" aria-label="Cadence home">
            <BrandMarks />
          </a>
          <div class="site-header__nav-area">
            <a class="button button--primary site-header__download" href={primaryCtas.downloadMac.href}>
              {primaryCtas.downloadMac.label}
            </a>
            <a class="site-header__login" href={primaryCtas.logIn.href}>
              {primaryCtas.logIn.label}
            </a>
          </div>
        </div>
      </header>
      <script is:inline>
        (() => {
          const FADE_DISTANCE = 48;
          const root = document.documentElement;
          let frameId = null;

          const update = () => {
            frameId = null;
            const y = window.scrollY || document.documentElement.scrollTop || 0;
            root.style.setProperty(
              "--site-header-border-opacity",
              Math.min(y / FADE_DISTANCE, 1).toFixed(3),
            );
          };

          const schedule = () => {
            if (frameId !== null) return;
            frameId = window.requestAnimationFrame(update);
          };

          update();
          window.addEventListener("scroll", schedule, { passive: true });
          window.addEventListener("resize", schedule);
        })();
      </script>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <p>
            © 2026 Cadence
          </p>
          <div class="cta-row" aria-label="Project links">
            <a class="inline-link" href="/faq">FAQ</a>
            <a class="inline-link" href="/about">About</a>
            <a class="inline-link" href="/developers">Developers</a>
            <a class="inline-link" href={primaryCtas.viewGithub.href}>GitHub</a>
            <a class="inline-link" href="/llms.txt">llms.txt</a>
          </div>
          <div class="cta-row" aria-label="Trust and legal links">
            <a class="inline-link" href={siteConfig.trustUrl}>Trust</a>
            <a class="inline-link" href={siteConfig.trustEvidenceUrl}>Trust evidence JSON</a>
            <a class="inline-link" href={`${siteConfig.cadenceAppUrl}/privacy`}>Privacy</a>
            <a class="inline-link" href={`${siteConfig.cadenceAppUrl}/terms`}>Terms</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
