#!/bin/sh
# Cadence pre-push checks (docs/OPERATIONS.md, "Branches and worktrees").
#
# Git runs this hook before every push, once core.hooksPath is .githooks.
# It runs the four fast governance checks, the tests that import a file this
# branch changed against origin/main, and a short list of tests that read
# source and docs through fs (vitest related cannot find those).
#
# The hook blocks a push only when a check fails. Every other problem (no
# origin/main, no node_modules, a cloud session) prints one note and lets the
# push through.
#
# Escape hatch:
#   CADENCE_SKIP_PRE_PUSH=1 git push ...   say why in the PR

note() { echo "pre-push: $*" >&2; }

[ "${CADENCE_SKIP_PRE_PUSH:-}" = "1" ] && { note "skipped (CADENCE_SKIP_PRE_PUSH=1)."; exit 0; }
# Claude Code cloud sessions run the checks themselves (scripts/claude-cloud-session.sh).
[ "${CLAUDE_CODE_REMOTE:-}" = "true" ] && exit 0

# Git sends one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# A deletion has an all-zero local sha. Pushes that only delete need no checks.
pushes=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in *[!0]*) pushes=$((pushes + 1)) ;; esac
done
[ "$pushes" -eq 0 ] && exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || { note "not in a work tree; checks skipped."; exit 0; }
cd "$root" || exit 0

[ -d node_modules ] || { note "node_modules is missing; checks skipped. Run npm ci."; exit 0; }

if ! git rev-parse --verify --quiet refs/remotes/origin/main >/dev/null 2>&1; then
  note "origin/main does not exist here; checks skipped."
  exit 0
fi
base=$(git merge-base HEAD refs/remotes/origin/main 2>/dev/null) || {
  note "git merge-base HEAD origin/main failed; checks skipped."
  exit 0
}

# CI and the Dagger checks use Node 24. Prefer it when the shell's node is another major.
node24=/opt/homebrew/opt/node@24/bin
major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)
if [ "$major" != "24" ] && [ -x "$node24/node" ]; then
  PATH="$node24:$PATH"
  export PATH
fi

# Tests that read source, docs or registries through fs. vitest related misses them.
GOVERNANCE_TESTS="tests/scheduled-for-drift.test.ts
tests/developer-docs.test.ts
tests/acceptance-watch.test.mjs
tests/integration-contract.test.ts
tests/desktop-parity.test.ts
tests/interaction-registry-labels.test.ts
tests/rls-policy-registry.test.ts"

# vitest.config.ts excludes these already; the flags keep the hook correct when
# CADENCE_WEB_CLIENT_TEST=1 is set in the shell.
VITEST_EXCLUDES="--exclude=.local/**
--exclude=.claude/**
--exclude=tests/acceptance-web-client/**"

log=$(mktemp "${TMPDIR:-/tmp}/cadence-pre-push.XXXXXX") || { note "mktemp failed; checks skipped."; exit 0; }
trap 'rm -f "$log"' EXIT
failed=0

# step <label> <command...>: run quietly, print one line, keep the output on failure.
step() {
  label=$1
  shift
  started=$(date +%s)
  if "$@" >"$log" 2>&1; then
    echo "pre-push: ok   $label ($(($(date +%s) - started)) s)" >&2
  else
    echo "pre-push: FAIL $label" >&2
    cat "$log" >&2
    failed=1
  fi
}

for check in agents:check interactions:check map:check resolvers:check; do
  step "$check" npm run --silent "$check"
done

# Lists below are newline-separated; split on newlines only and never glob.
IFS='
'
set -f
governance=""
for file in $GOVERNANCE_TESTS; do
  [ -f "$file" ] && governance="$governance$file
"
done
# shellcheck disable=SC2086
[ -n "$governance" ] && step "governance tests" npx vitest run $governance $VITEST_EXCLUDES

changed=$(git diff --name-only --diff-filter=d "$base" HEAD -- '*.ts' '*.tsx' '*.mjs')
if [ -n "$changed" ]; then
  count=$(printf '%s\n' "$changed" | wc -l | tr -d ' ')
  # shellcheck disable=SC2086
  step "vitest related for $count changed file(s)" \
    npx vitest related --run --passWithNoTests $changed $VITEST_EXCLUDES
else
  echo "pre-push: skip vitest related (no .ts, .tsx or .mjs change against origin/main)" >&2
fi

if [ "$failed" -ne 0 ]; then
  echo "push blocked by .githooks/pre-push; fix the check or set CADENCE_SKIP_PRE_PUSH=1 and say why in the PR" >&2
  exit 1
fi
exit 0
