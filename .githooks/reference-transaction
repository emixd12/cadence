#!/bin/sh
# Cadence branch guard (docs/OPERATIONS.md, "Branches and worktrees").
#
# Git runs this hook for every ref update, whichever agent or person runs Git.
# It refuses to create a local branch that does not contain origin/main, so new
# work never starts from stale code. Existing branches, remote-tracking refs,
# tags and deletions pass untouched.
#
# Escape hatches:
#   CADENCE_ALLOW_STALE_BRANCH=1 git ...        one command
#   git config cadence.branchGuard warn         warn instead of refusing
#   git config cadence.branchGuard off          turn the guard off in this clone

[ "$1" = "prepared" ] || exit 0
[ "${CADENCE_ALLOW_STALE_BRANCH:-}" = "1" ] && exit 0

mode=$(git config --get cadence.branchGuard 2>/dev/null || echo block)
[ "$mode" = "off" ] && exit 0

status=0
while read -r old new ref; do
  case "$ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  # Only creations: the old value is all zeros and the new value is not.
  case "$old" in *[!0]*) continue ;; esac
  case "$new" in *[!0]*) ;; *) continue ;; esac

  base=$(git rev-parse --quiet --verify refs/remotes/origin/main 2>/dev/null) || continue
  git merge-base --is-ancestor "$base" "$new" 2>/dev/null && continue

  branch=${ref#refs/heads/}
  behind=$(git rev-list --count "$new..$base" 2>/dev/null || echo "?")
  {
    echo "cadence branch guard: new branch '$branch' starts $behind commit(s) behind origin/main."
    echo "  Start from the latest code:  git fetch origin && git switch -c $branch origin/main"
    echo "  Worktree form:               git worktree add -b $branch <path> origin/main"
    echo "  To stack on, review or rename an older branch on purpose, rerun with"
    echo "  CADENCE_ALLOW_STALE_BRANCH=1, or use --detach. Rule: AGENTS.md, \"Git branches and worktrees\"."
  } >&2
  [ "$mode" = "warn" ] || status=1
done

exit $status
